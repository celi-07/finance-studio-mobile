{
  "expo": {
    "name": "Finance Studio",
    "slug": "finance-studio-mobile",
    "scheme": "financestudio",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.celi07.financestudio",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.celi07.financestudio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161616"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1f3f8",
          "image": "./assets/splash-light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#10141f",
            "image": "./assets/splash-dark.png"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "33ec4134-bc83-4dc7-bed4-73dcb07448fc"
      }
    },
    "owner": "celi-07"
  }
}
