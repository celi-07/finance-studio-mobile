{
  "expo": {
    "name": "Finance Studio",
    "slug": "finance-studio-mobile",
    "scheme": "financestudio",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.celi07.financestudio",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.celi07.financestudio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161616"
      }
    },
    "plugins": ["expo-secure-store", "expo-web-browser", "expo-sharing"],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
