# Optional overrides. Without overrides the app uses the website's public Supabase config.
# Copy BOTH values from the SAME Supabase project. Never use a service-role key.
# Explicitly leaving both empty selects standalone demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# google, transition, oauth, or email. Must match the site's enabled providers.
EXPO_PUBLIC_AUTH_MODE=google
